[Unit]
Description=Re-apply G-Wolves HSK settings when the mouse appears
Documentation=https://github.com/keasbeexd/omarchy-hsk

[Service]
Type=oneshot
# A safety net, not an explanation. The mouse does persist settings written by
# the vendor app -- they follow it between machines -- but writes from hskctl
# currently do not survive a power cycle. Until that is understood, re-apply
# the saved settings when the mouse reappears.
#
# The delay lets the dongle finish enumerating; without it the first exchange
# can land before the config endpoint exists.
ExecStartPre=/usr/bin/sleep 2
ExecStart=%h/.local/bin/hskctl apply

[Install]
WantedBy=default.target
