#!/usr/bin/bash
# Launcher for the copy of hskctl that ships inside this plugin.
#
# Omarchy clones the plugin to ~/.config/omarchy/plugins/<id>/, so the CLI
# travels with it and the widget works straight after `omarchy plugin add`
# with nothing else installed.
#
# The interpreter is always /usr/bin/python3, with no override: a rogue
# python3 would be handed the hidraw file descriptor, so nothing on PATH or in
# the environment gets to choose it. `-I` is isolated mode (no PYTHONPATH, no
# user site-packages) and `-S` skips site-packages entirely -- hskctl uses
# only the standard library and imports the bundled package by explicit path.
set -euo pipefail
SELF="$(/usr/bin/readlink -f -- "${BASH_SOURCE[0]}")"
HERE="${SELF%/bin/hskctl}"

exec /usr/bin/python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv[1]); from hskctl.cli import main; sys.exit(main(sys.argv[2:]))' "$HERE" "$@"
