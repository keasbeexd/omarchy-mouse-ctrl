{
  "schemaVersion": 1,
  "id": "keasbeexd.mousectrl",
  "name": "Mouse Control",
  "version": "2.0.0",
  "author": "Marc (@keasbee)",
  "license": "MIT",
  "description": "Battery, DPI, polling rate and sensor settings for supported G-Wolves and Pulsar mice, in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Mouse Control",
    "description": "Show mouse battery and switch DPI, polling rate, and sensor settings.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 5,
      "lowBatteryPercent": 15,
      "showBatteryLabel": true,
      "hskctlPath": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 3600,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "lowBatteryPercent",
        "type": "integer",
        "label": "Low battery warning at (%)",
        "min": 0,
        "max": 50,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "showBatteryLabel",
        "type": "boolean",
        "label": "Show battery percentage in the bar",
        "defaultValue": true
      },
      {
        "key": "hskctlPath",
        "type": "string",
        "label": "Path to hskctl (blank = the copy bundled with this plugin)",
        "defaultValue": ""
      }
    ]
  }
}
