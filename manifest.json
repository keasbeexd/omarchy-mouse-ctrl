{
  "schemaVersion": 1,
  "id": "io.github.keasbeexd.hsk",
  "name": "HSK Mouse",
  "version": "1.4.0",
  "author": "Marc (@keasbee)",
  "license": "MIT",
  "description": "Battery, DPI, polling rate and sensor settings for the G-Wolves HSK Pro 4K, in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "HSK Mouse",
    "description": "Show mouse battery and switch DPI, polling rate, and sensor settings.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "lowBatteryPercent": 15,
      "showBatteryLabel": true,
      "hskctlPath": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "lowBatteryPercent",
        "type": "integer",
        "label": "Low battery warning at (%)",
        "min": 0,
        "max": 50,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "showBatteryLabel",
        "type": "boolean",
        "label": "Show battery percentage in the bar",
        "defaultValue": true
      },
      {
        "key": "hskctlPath",
        "type": "string",
        "label": "Path to hskctl (blank = the copy bundled with this plugin)",
        "defaultValue": ""
      }
    ]
  }
}
